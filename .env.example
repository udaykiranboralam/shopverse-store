# Database
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/greatcoder_ai?schema=public"

# NextAuth
NEXTAUTH_URL="https://your-domain.com"
NEXTAUTH_SECRET="generate-a-long-random-secret"

# AI Provider (OpenAI-compatible - works with OpenAI, Azure, Groq, etc.)
AI_API_KEY="your-ai-provider-key"
AI_BASE_URL="https://api.openai.com/v1"
AI_MODEL="gpt-4o-mini"

# Meta Lead Ads / Facebook Webhook
META_VERIFY_TOKEN="random-string-for-webhook-verification"
META_APP_SECRET="your-meta-app-secret"
META_ACCESS_TOKEN="your-meta-page-access-token"

# WhatsApp Business API
WHATSAPP_API_URL="https://graph.facebook.com/v18.0/YOUR_PHONE_NUMBER_ID/messages"
WHATSAPP_ACCESS_TOKEN="your-whatsapp-access-token"
WHATSAPP_VERIFY_TOKEN="random-string-for-whatsapp-verification"
